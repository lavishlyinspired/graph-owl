/target
.DS_Store
.env

# Local reference material, not part of this project — never committed
.claude/docs/

# Local design workspace. Holds a branded dashboard mock that carries
# third-party company logos in a "trusted by" strip; committing it to a public
# repo would publish an endorsement claim that does not exist.
.opencode/

# Local-only Claude Code settings, not shared
.claude/settings.local.json

# cargo-mutants scratch output
/mutants.out/
/mutants.out.old/

.gitignore

.claude/docs/analysis.md
.claude/docs/analysis2.md


.claude/docs/graph-owl-crate-architecture.md
.claude/docs/graph-owl-engine.md
.claude/docs/KGDOCS_to_GRAPHOWL_PLAN.md


# Frontend build output and dependencies
/ui/node_modules/
# The console's tooling lives in `ui/`, but a stray `npx`/`vitest` run from the
# repo root creates a cache here instead. Ignored so it cannot be committed by a
# broad `git add -A` — which is exactly how an untracked file got swept into
# somebody else's commit on 30 July 2026.
/node_modules/
/ui/dist/
/ui/.stryker-tmp/
# Playwright's own trace/screenshot artifacts (Epic 39 Slice F) — regenerated
# by every run of scripts/verify-first-run-journey.sh, never source.
/ui/test-results/
/ui/playwright-report/

# Generated SDK artifacts. The client types are derived from `openapi.json`, and
# a committed copy is a second thing to keep in step with the first — the same
# reasoning as `scripts/verify-generated-client.sh`.
/sdk/typescript/node_modules/
/sdk/typescript/src/generated/
/sdk/python/.venv/
/sdk/python/build/
/sdk/python/*.egg-info/
# `graph_owl_read_client` itself (Epic 36 Slice D) is generated the same way
# `sdk/typescript/src/generated/` is above — its own `pyproject.toml` is
# hand-written and stays committed. Regenerate with `scripts/verify-examples.sh`
# or `plans/00l-build-vs-adopt.md`'s recorded `openapi-python-client` command.
/sdk/python/graph_owl_read_client/src/
/sdk/python/graph_owl_read_client/*.egg-info/
__pycache__/
.pytest_cache/
# Python worker: editable-install metadata and mutmut's mutant scratch space.
/workers/python/*.egg-info/
/workers/python/mutants/
/workers/python/mutants.out
/workers/python/.mutmut-cache
# Pack loader: editable-install metadata, same as the worker and SDK above.
/connectors/python/*.egg-info/
.git/credentials
research
/research
