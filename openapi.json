{
  "components": {
    "schemas": {
      "Asset": {
        "description": "A node in the asset hierarchy: service → database → schema → table → column.\n\nOne struct for all five levels rather than five near-identical structs. What\ndiffers between a schema and a table is the *kind* and what may contain it,\nnot the fields — and five structs would mean five repositories, five\nhandlers and five UI pages for one concept (`01-api-conventions.md`\ndecision 10, `39-ui-foundation.md` decision 4).",
        "properties": {
          "changeDescription": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChangeDescription",
                "description": "What changed to produce this version. `None` on the initial version:\nthere was nothing before it to diff against, and an empty diff would\nread as \"nothing changed\" rather than \"this is where it began\"."
              }
            ]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          },
          "deletedAt": {
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "fullyQualifiedName": {
            "description": "Derived from the parent chain, never client-set.",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "properties": {
            "description": "Free-form, kind-specific: a column's data type, a service's engine.\nKept open because every warehouse reports something slightly different\nand normalising it prematurely loses information the catalog is for."
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "version": {
            "$ref": "#/components/schemas/EntityVersion"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "fullyQualifiedName",
          "version",
          "updatedBy",
          "deleted",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "AssetKind": {
        "enum": [
          "service",
          "database",
          "schema",
          "table",
          "column"
        ],
        "type": "string"
      },
      "AssetUpdate": {
        "description": "A partial update. Absent means \"not declared\"; explicit `null` means clear.\nThe distinction is what stops a connector's null description from blanking\nwhat a human wrote (`15-connectors.md` decision 3).",
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "AssetVersion": {
        "description": "A past state of an asset, with what produced it.",
        "properties": {
          "changeDescription": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ChangeDescription"
              }
            ]
          },
          "snapshot": {
            "$ref": "#/components/schemas/Asset"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedBy": {
            "type": "string"
          },
          "version": {
            "$ref": "#/components/schemas/EntityVersion"
          }
        },
        "required": [
          "version",
          "snapshot",
          "updatedBy",
          "updatedAt"
        ],
        "type": "object"
      },
      "AssetVersion_Array": {
        "items": {
          "$ref": "#/components/schemas/AssetVersion"
        },
        "type": "array"
      },
      "Asset_Array": {
        "items": {
          "$ref": "#/components/schemas/Asset"
        },
        "type": "array"
      },
      "CascadeCount": {
        "description": "How many assets the operation affected, including the subtree.",
        "properties": {
          "deleted": {
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ChangeDescription": {
        "description": "Computed server-side by diffing before against after — never supplied by the\nclient. This is why PATCH stays DTO-shaped rather than JSON Patch: a state\ndiff describes *effect*, a patch document describes *intent*, and an audit\ntrail wants effect.",
        "properties": {
          "fieldsAdded": {
            "items": {
              "$ref": "#/components/schemas/FieldChange"
            },
            "type": "array"
          },
          "fieldsDeleted": {
            "items": {
              "$ref": "#/components/schemas/FieldChange"
            },
            "type": "array"
          },
          "fieldsUpdated": {
            "items": {
              "$ref": "#/components/schemas/FieldChange"
            },
            "type": "array"
          }
        },
        "required": [
          "fieldsAdded",
          "fieldsUpdated",
          "fieldsDeleted"
        ],
        "type": "object"
      },
      "ChangeKind": {
        "description": "How much a change is worth. `None` is a real outcome, not an absence: a\nconnector re-running against an unchanged source must produce no version and\nno event, and that is what makes its idempotency observable.",
        "enum": [
          "None",
          "Minor",
          "Major"
        ],
        "type": "string"
      },
      "CreateRelationship": {
        "properties": {
          "relationshipType": {
            "type": "string"
          },
          "toTableId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": [
          "toTableId",
          "relationshipType"
        ],
        "type": "object"
      },
      "CreateTable": {
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "fullyQualifiedName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "fullyQualifiedName"
        ],
        "type": "object"
      },
      "EntityVersion": {
        "description": "`Major.Minor`, starting at `0.1`.\n\nMinor for backward-compatible change (description, tags, owners); Major for\nbreaking change (a column dropped, a type changed, a rename). The split\nmatters because a consumer can subscribe to Major alone and get exactly the\nchanges that could break it.",
        "properties": {
          "major": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "minor": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "major",
          "minor"
        ],
        "type": "object"
      },
      "FieldChange": {
        "description": "One field's before and after. `None` on either side means the field was\nadded or removed — distinct from changed, because a consumer reacts\ndifferently to a dropped column than to a retyped one.",
        "properties": {
          "after": {},
          "before": {},
          "field": {
            "type": "string"
          }
        },
        "required": [
          "field"
        ],
        "type": "object"
      },
      "Page_Asset": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Asset"
            },
            "type": "array"
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          }
        },
        "required": [
          "data",
          "paging"
        ],
        "type": "object"
      },
      "Page_Table": {
        "properties": {
          "data": {
            "items": {
              "$ref": "#/components/schemas/Table"
            },
            "type": "array"
          },
          "paging": {
            "$ref": "#/components/schemas/Paging"
          }
        },
        "required": [
          "data",
          "paging"
        ],
        "type": "object"
      },
      "Paging": {
        "properties": {
          "after": {
            "description": "Token for the next page, or `None` on the last one. Nullness is the\nonly end-of-results signal a client gets, so it must be exact.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Problem": {
        "description": "RFC 9457 problem details. Every error response uses this shape.",
        "properties": {
          "detail": {
            "type": "string"
          },
          "errors": {
            "description": "Field violations, all of them — never just the first.",
            "items": {
              "properties": {
                "code": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "description": "Stable URI naming the error kind. The only field a client should branch on.",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "type": "object"
      },
      "Relationship": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "fromEntityId": {
            "format": "uuid",
            "type": "string"
          },
          "fromEntityType": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "relationshipType": {
            "type": "string"
          },
          "toEntityId": {
            "format": "uuid",
            "type": "string"
          },
          "toEntityType": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "fromEntityType",
          "fromEntityId",
          "relationshipType",
          "toEntityType",
          "toEntityId",
          "createdAt"
        ],
        "type": "object"
      },
      "Relationship_Array": {
        "items": {
          "$ref": "#/components/schemas/Relationship"
        },
        "type": "array"
      },
      "Table": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "fullyQualifiedName": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "fullyQualifiedName",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "TableUpdate": {
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "UpsertAsset": {
        "properties": {
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "$ref": "#/components/schemas/AssetKind"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "format": "uuid",
            "type": [
              "string",
              "null"
            ]
          },
          "properties": {}
        },
        "required": [
          "kind",
          "name"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "description": "An OIDC access token (RS256, verified against the issuer's JWKS), or an HS256 token when the server is configured with a shared secret.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "A knowledge graph engine for enterprise metadata. Errors are RFC 9457 problem documents; lists are keyset-paginated. See plans/00d-api-conventions.md.",
    "title": "graph-owl",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/assets": {
      "get": {
        "operationId": "get_assets",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_Asset"
                }
              }
            },
            "description": "List assets"
          }
        },
        "security": [],
        "summary": "List assets"
      },
      "post": {
        "operationId": "post_assets",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertAsset"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            },
            "description": "Create or update an asset by FQN"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The request body is invalid; every violation is listed"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Create or update an asset by FQN"
      }
    },
