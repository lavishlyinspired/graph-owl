# GSTR-1/IFF — what the suppliers *declared*, in their own filings.
#
# **The third evidence source, and the one that makes "unmatched" explainable**
# (`plans/108-books-gstr1-gstr2b-reconciliation.md` Slice 1). Books say what
# the taxpayer claims; GSTR-2B says what the authority made available; this
# says what the supplier told the authority. With only the first two, an
# invoice missing from 2B has one finding and two completely different causes:
# the supplier never filed it (chase the supplier), or the supplier filed it
# and it never reached this taxpayer (chase the mapping — wrong GSTIN, B2C
# misclassification, filed after the period's 2B was generated). A CA takes
# opposite actions in those two cases, so they are two findings.
#
# **`filedDate` is what carries the explanation.** INV-1007 below is dated in
# July and was filed on 18 August. That single fact is why it cannot be in
# July's GSTR-2B — and the graph never has to know what a cut-off is to say
# so, because the 2B document for a period either contains an invoice or it
# does not, and that document is the authority's own answer.
#
# Planted so that every new rule has a case that fires **and** a case that
# must not — the clean rows are what prove a rule discriminates:
#
#   INV-1001  declared, matches books and 2B          → nothing
#   INV-1002  declared at 95,000, books claim 100,000 → BooksGstr1Mismatch
#   INV-1003  *absent* — the supplier never filed it  → SupplierNotFiled
#   INV-1004  declared under the *correct* GSTIN      → nothing new
#   INV-1007  declared 18 Aug, in no 2B this pack has → Gstr1NotIn2b
#   INV-1008  declared and in 2B, absent from books   → MissingInBooks
#   INV-1009  *absent*, and reverse-charge in books   → nothing (the negative)
#   INV-2001  5% below books, cap in force was 10%    → nothing
#   INV-2002  20% below books, cap in force was 10%   → BooksGstr1Mismatch
#
# INV-2001 and INV-2002 are the pair worth reading twice, and they are the
# same pair `purchase-register.ttl` plants for `AmountMismatch`: identical
# rule, identical query, different answer, because `law/rule-36-4.ttl` says
# the cap in force in July 2020 was 10%. A hardcoded tolerance would report
# INV-2001 as a finding every month and a reviewer would be dismissing a
# compliant invoice forever.
#
# **Plan 109 Slice 2: `period`/`filedDate` move off every per-line record
# here onto a `gst:Gstr1Filing` — one per (supplier, return period), not one
# per invoice line — and each declared line points at its filing with
# `filedIn`.** Every invoice below also gets an `appearsIn` edge from its
# canonical `gst:Invoice` subject, computed the identical deterministic way
# `purchase-register.ttl` computes it: `gst:invoice-{supplierGstin}-
# {invoiceKey}`. Where the GSTIN here differs from the register's (INV-1004,
# INV-1015 — see that file's own comment), the canonical subject computed is
# *deliberately* a different one; nothing here forces a merge.
#
# Authored from the published GST return format, which is the specification
# (`plans/00i-licensing.md` rule 2).

@prefix gst: <https://graph-owl.dev/packs/gst#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# The same Supplier subjects the register and the 2B already point at — this
# document adds the trade name the supplier files under, which neither of the
# other two carries. That is the whole argument for subjects over literals:
# a third source enriches the *same* node rather than creating a fourth copy
# of a GSTIN string.
gst:supplier-27AABCU9603R1ZM rdf:type gst:Supplier ;
    gst:supplierGstin "27AABCU9603R1ZM" ;
    gst:supplierName  "Umbrella Industrial Supplies Pvt Ltd" .

gst:supplier-29AACCG0527D1Z8 rdf:type gst:Supplier ;
    gst:supplierGstin "29AACCG0527D1Z8" ;
    gst:supplierName  "Ganga Components Ltd" .

gst:supplier-33AAGCV2109L1ZH rdf:type gst:Supplier ;
    gst:supplierGstin "33AAGCV2109L1ZH" ;
    gst:supplierName  "Vaigai Packaging LLP" .

# **The filings — one per (supplier, return period), deduplicated across
# every invoice line they cover.** Five filings below: three suppliers filing
# for July 2026, one of those three's carry-forward filing for August 2026,
# and the same first supplier's July 2020 filing (the historical pair).
gst:g1filing-27AABCU9603R1ZM-2026-07 rdf:type gst:Gstr1Filing ;
    gst:period    "2026-07" ;
    gst:belongsToPeriod gst:period-2026-07 ;
    gst:filedDate "2026-08-11" ;
    gst:filedBy   gst:supplier-27AABCU9603R1ZM .

gst:g1filing-29AACCG0527D1Z8-2026-07 rdf:type gst:Gstr1Filing ;
    gst:period    "2026-07" ;
    gst:belongsToPeriod gst:period-2026-07 ;
    gst:filedDate "2026-08-18" ;
    gst:filedBy   gst:supplier-29AACCG0527D1Z8 .

gst:g1filing-33AAGCV2109L1ZH-2026-07 rdf:type gst:Gstr1Filing ;
    gst:period    "2026-07" ;
    gst:belongsToPeriod gst:period-2026-07 ;
    gst:filedDate "2026-08-11" ;
    gst:filedBy   gst:supplier-33AAGCV2109L1ZH .

gst:g1filing-27AABCU9603R1ZM-2026-08 rdf:type gst:Gstr1Filing ;
    gst:period    "2026-08" ;
    gst:belongsToPeriod gst:period-2026-08 ;
    gst:filedDate "2026-09-09" ;
    gst:filedBy   gst:supplier-27AABCU9603R1ZM .

gst:g1filing-27AABCU9603R1ZM-2020-07 rdf:type gst:Gstr1Filing ;
    gst:period    "2020-07" ;
    gst:belongsToPeriod gst:period-2020-07 ;
    gst:filedDate "2020-08-11" ;
    gst:filedBy   gst:supplier-27AABCU9603R1ZM .

gst:g1-INV-1001 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1001" ;
    gst:invoiceKey    "INV1001" ;
    gst:invoiceDate   "2026-07-04" ;
    gst:taxableValue  "100000.00" ;
    gst:taxAmount     "18000.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1001 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1001 .

# Declared 5,000 lower than the register claims. The supplier is not
# necessarily wrong here — that is precisely why the finding names both
# figures and leaves the judgement to a reviewer.
gst:g1-INV-1002 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1002" ;
    gst:invoiceKey    "INV1002" ;
    gst:invoiceDate   "2026-07-09" ;
    gst:taxableValue  "95000.00" ;
    gst:taxAmount     "17100.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1002 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1002 .

# INV-1003 is deliberately absent — the supplier has filed nothing for it.

gst:g1-INV-1004 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1004" ;
    gst:invoiceKey    "INV1004" ;
    gst:invoiceDate   "2026-07-22" ;
    gst:taxableValue  "50000.00" ;
    gst:taxAmount     "9000.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

# Filed under the *correct* GSTIN — this is the canonical subject that
# GSTR-2B's own INV-1004 line also computes, below in `gstr2b.ttl`. The
# register's INV-1004 computes a different one (`…1MZ`, the transposed GSTIN)
# and is deliberately never merged into this one.
gst:invoice-27AABCU9603R1ZM-INV1004 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1004 .

gst:g1-INV-1005 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1005" ;
    gst:invoiceKey    "INV1005" ;
    gst:invoiceDate   "2026-07-24" ;
    gst:taxableValue  "40000.00" ;
    gst:taxAmount     "7200.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1005 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1005 .

gst:g1-INV-1006 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1006" ;
    gst:invoiceKey    "INV1006" ;
    gst:invoiceDate   "2026-07-26" ;
    gst:taxableValue  "60000.00" ;
    gst:taxAmount     "10800.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1006 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1006 .

# **The Gstr1NotIn2b case.** Declared for the July period and filed on 18
# August, and present in no GSTR-2B this pack holds — July's was generated
# before it arrived, and August's does not carry it either. The next action
# is to ask the supplier which return it actually went into and under whose
# GSTIN, not to ask whether they filed at all.
gst:g1-INV-1007 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-29AACCG0527D1Z8 ;
    gst:invoiceNumber "INV-1007" ;
    gst:invoiceKey    "INV1007" ;
    gst:invoiceDate   "2026-07-28" ;
    gst:taxableValue  "30000.00" ;
    gst:taxAmount     "5400.00" ;
    gst:filedIn       gst:g1filing-29AACCG0527D1Z8-2026-07 .

gst:invoice-29AACCG0527D1Z8-INV1007 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-29AACCG0527D1Z8 ;
    gst:appearsIn gst:g1-INV-1007 .

# **The MissingInBooks case.** The supplier declared it, the authority made it
# available, and the taxpayer's register has no such invoice. Either the
# purchase was never recorded — in which case there is credit sitting
# unclaimed — or somebody has filed against the wrong GSTIN. Both are worth a
# question; neither is something this pack should write into the books.
gst:g1-INV-1008 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-33AAGCV2109L1ZH ;
    gst:invoiceNumber "INV-1008" ;
    gst:invoiceKey    "INV1008" ;
    gst:invoiceDate   "2026-07-19" ;
    gst:taxableValue  "45000.00" ;
    gst:taxAmount     "8100.00" ;
    gst:filedIn       gst:g1filing-33AAGCV2109L1ZH-2026-07 .

gst:invoice-33AAGCV2109L1ZH-INV1008 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-33AAGCV2109L1ZH ;
    gst:appearsIn gst:g1-INV-1008 .

# INV-1009 is deliberately absent. It is a reverse-charge purchase, and the
# recipient self-assesses the tax — there is no supplier-side GSTR-1 line to
# wait for, so `SupplierNotFiled` must stay silent on it. Without this row the
# rule would fire on every RCM invoice a real taxpayer holds, which is the
# false-positive rate that makes a reviewer stop trusting the queue.

gst:g1-INV-1010 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1010" ;
    gst:invoiceKey    "INV1010" ;
    gst:invoiceDate   "2026-08-30" ;
    gst:taxableValue  "20000.00" ;
    gst:taxAmount     "3600.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-08 .

gst:invoice-27AABCU9603R1ZM-INV1010 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1010 .

gst:g1-INV-1011 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1011" ;
    gst:invoiceKey    "INV1011" ;
    gst:invoiceDate   "2026-08-12" ;
    gst:taxableValue  "15000.00" ;
    gst:taxAmount     "2700.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-08 .

gst:invoice-27AABCU9603R1ZM-INV1011 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1011 .

# The 2020 pair. Same delta shape as `AmountMismatch`'s own, against a
# different named graph — 5% under a 10% cap is compliant, 20% is not.
gst:g1-INV-1012 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1012" ;
    gst:invoiceKey    "INV1012" ;
    gst:invoiceDate   "2026-07-29" ;
    gst:taxableValue  "100000.00" ;
    gst:taxAmount     "18000.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1012 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1012 .

# The supplier's own spelling of the same invoice — a third format.
gst:g1-INV-1014 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV 1014" ;
    gst:invoiceKey    "INV1014" ;
    gst:invoiceDate   "2026-07-31" ;
    gst:taxableValue  "70000.00" ;
    gst:taxAmount     "12600.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1014 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1014 .

gst:g1-INV-1015 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1015" ;
    gst:invoiceKey    "INV1015" ;
    gst:invoiceDate   "2026-07-31" ;
    gst:taxableValue  "80000.00" ;
    gst:taxAmount     "14400.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2026-07 .

# Filed under the Maharashtra registration — the canonical subject this
# computes is deliberately different from the register's, which booked this
# invoice against the Karnataka registration of the same PAN. See
# `purchase-register.ttl`'s own comment on INV-1015.
gst:invoice-27AABCU9603R1ZM-INV1015 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-1015 .

gst:g1-INV-2001 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-2001" ;
    gst:invoiceKey    "INV2001" ;
    gst:invoiceDate   "2020-07-10" ;
    gst:taxableValue  "95000.00" ;
    gst:taxAmount     "17100.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2020-07 .

gst:invoice-27AABCU9603R1ZM-INV2001 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-2001 .

gst:g1-INV-2002 rdf:type gst:Gstr1Invoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-2002" ;
    gst:invoiceKey    "INV2002" ;
    gst:invoiceDate   "2020-07-12" ;
    gst:taxableValue  "80000.00" ;
    gst:taxAmount     "14400.00" ;
    gst:filedIn       gst:g1filing-27AABCU9603R1ZM-2020-07 .

gst:invoice-27AABCU9603R1ZM-INV2002 rdf:type gst:Invoice ;
    gst:issuedBy  gst:supplier-27AABCU9603R1ZM ;
    gst:appearsIn gst:g1-INV-2002 .
