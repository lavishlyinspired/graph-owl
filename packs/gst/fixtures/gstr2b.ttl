# GSTR-2B — what the suppliers actually filed, as the authority reports it.
#
# INV-1003 is deliberately absent: that is scenario 3, and its absence is the
# finding. INV-1004 is present under the *correct* GSTIN, which is what makes
# the transposition detectable at all — the pair exists, only the identifier
# disagrees.
#
# `itcAvailable` and `reverseCharge` are reported per line by the authority
# and are not derivable from the taxpayer's own register, which is exactly why
# they are worth reconciling: a perfectly matched invoice can still carry no
# usable credit.
#
# **`gst:Supplier` is a real subject here, not a literal on the invoice —
# Epic 105c.** Every line below is filed under the one correct GSTIN, so
# there is exactly one Supplier subject in this document — the same subject
# `purchase-register.ttl`'s matching invoices point at, which is what makes a
# join across the two documents a graph traversal rather than a string
# comparison.
#
# **Plan 109 Slice 2: `period` moves off every per-line record here onto a
# `gst:Gstr2bStatement` — one per return period, generated for the single
# well-known `gst:Recipient` this pack is single-tenant for — and each line
# points at its statement with `reflectedIn`, reused at the second level
# exactly as `plans/109-gst-canonical-invoice-model.md` decision 4 describes.
# Every invoice below also gets a `reflectedIn` edge (the first-level one)
# from its canonical `gst:Invoice` subject, computed identically to
# `purchase-register.ttl`/`gstr1.ttl`.** This file mixes two periods
# (2026-07 and the historical 2020-07 pair) exactly as it already did before
# this migration — that pre-existing shape is unchanged; only the
# canonical-entity and Filing/Statement layers are new.

@prefix gst: <https://graph-owl.dev/packs/gst#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

gst:supplier-27AABCU9603R1ZM rdf:type gst:Supplier ;
    gst:supplierGstin "27AABCU9603R1ZM" .

# A supplier this taxpayer's own register has never heard of — which is the
# entire point of INV-1008 below.
gst:supplier-33AAGCV2109L1ZH rdf:type gst:Supplier ;
    gst:supplierGstin "33AAGCV2109L1ZH" .

# The taxpayer this deployment represents — single-tenant, so exactly one
# instance, and every statement below points at it.
gst:recipient-self rdf:type gst:Recipient .

gst:g2bstatement-2026-07 rdf:type gst:Gstr2bStatement ;
    gst:period       "2026-07" ;
    gst:generatedFor gst:recipient-self .

gst:g2bstatement-2020-07 rdf:type gst:Gstr2bStatement ;
    gst:period       "2020-07" ;
    gst:generatedFor gst:recipient-self .

gst:2b-INV-1001 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1001" ;
    gst:invoiceKey    "INV1001" ;
    gst:invoiceDate   "2026-07-04" ;
    gst:taxableValue  "100000.00" ;
    gst:taxAmount     "18000.00" ;
    gst:igst          "18000.00" ;
    gst:cgst          "0.00" ;
    gst:sgst          "0.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1001 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1001 .

gst:2b-INV-1002 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1002" ;
    gst:invoiceKey    "INV1002" ;
    gst:invoiceDate   "2026-07-09" ;
    gst:taxableValue  "95000.00" ;
    gst:taxAmount     "17100.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1002 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1002 .

gst:2b-INV-1004 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1004" ;
    gst:invoiceKey    "INV1004" ;
    gst:invoiceDate   "2026-07-22" ;
    gst:taxableValue  "50000.00" ;
    gst:taxAmount     "9000.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

# Filed under the correct GSTIN — the same canonical subject GSTR-1's own
# INV-1004 line computes. The register's INV-1004 (transposed GSTIN) computes
# a different one and stays unmerged.
gst:invoice-27AABCU9603R1ZM-INV1004 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1004 .

gst:2b-INV-1005 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1005" ;
    gst:invoiceKey    "INV1005" ;
    gst:invoiceDate   "2026-07-24" ;
    gst:taxableValue  "40000.00" ;
    gst:taxAmount     "7200.00" ;
    gst:itcAvailable  "N" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1005 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1005 .

gst:2b-INV-1006 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1006" ;
    gst:invoiceKey    "INV1006" ;
    gst:invoiceDate   "2026-07-26" ;
    gst:taxableValue  "60000.00" ;
    gst:taxAmount     "10800.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "R" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1006 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1006 .

# Filed by the supplier and made available to this taxpayer, with no register
# row to match — `MissingInBooks`. Credit sitting unclaimed, or somebody
# filing against the wrong GSTIN; either way a question, never a write.
gst:2b-INV-1008 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-33AAGCV2109L1ZH ;
    gst:invoiceNumber "INV-1008" ;
    gst:invoiceKey    "INV1008" ;
    gst:invoiceDate   "2026-07-19" ;
    gst:taxableValue  "45000.00" ;
    gst:taxAmount     "8100.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-33AAGCV2109L1ZH-INV1008 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-33AAGCV2109L1ZH ;
    gst:reflectedIn gst:2b-INV-1008 .

# The same invoice the register booked as inter-state, filed as intra-state.
# Totals identical on both sides; only the heads disagree.
gst:2b-INV-1012 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1012" ;
    gst:invoiceKey    "INV1012" ;
    gst:invoiceDate   "2026-07-29" ;
    gst:taxableValue  "100000.00" ;
    gst:taxAmount     "18000.00" ;
    gst:igst          "0.00" ;
    gst:cgst          "9000.00" ;
    gst:sgst          "9000.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1012 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1012 .

# 50 paise above the register, and no GSTR-1 row — the pair that proves the
# de-minimis floor and the 2B-presence guard both hold.
gst:2b-INV-1013 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1013" ;
    gst:invoiceKey    "INV1013" ;
    gst:invoiceDate   "2026-07-31" ;
    gst:taxableValue  "50000.00" ;
    gst:taxAmount     "9000.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1013 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1013 .

# The authority's own spelling of the invoice the register writes `INV/1014`.
gst:2b-INV-1014 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1014" ;
    gst:invoiceKey    "INV1014" ;
    gst:invoiceDate   "2026-07-31" ;
    gst:taxableValue  "70000.00" ;
    gst:taxAmount     "12600.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

gst:invoice-27AABCU9603R1ZM-INV1014 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1014 .

# Filed under the Maharashtra registration of the entity the register booked
# under its Karnataka one. Same PAN, different state.
gst:2b-INV-1015 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-1015" ;
    gst:invoiceKey    "INV1015" ;
    gst:invoiceDate   "2026-07-31" ;
    gst:taxableValue  "80000.00" ;
    gst:taxAmount     "14400.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2026-07 .

# Filed under Maharashtra — the same canonical subject GSTR-1's INV-1015 line
# computes. The register's INV-1015 (booked under Karnataka) computes a
# different one and stays unmerged.
gst:invoice-27AABCU9603R1ZM-INV1015 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-1015 .

gst:2b-INV-2001 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-2001" ;
    gst:invoiceKey    "INV2001" ;
    gst:invoiceDate   "2020-07-10" ;
    gst:taxableValue  "95000.00" ;
    gst:taxAmount     "17100.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2020-07 .

gst:invoice-27AABCU9603R1ZM-INV2001 rdf:type gst:Invoice ;
    gst:issuedBy    gst:supplier-27AABCU9603R1ZM ;
    gst:reflectedIn gst:2b-INV-2001 .

gst:2b-INV-2002 rdf:type gst:Gstr2bInvoice ;
    gst:issuedBy      gst:supplier-27AABCU9603R1ZM ;
    gst:invoiceNumber "INV-2002" ;
    gst:invoiceKey    "INV2002" ;
    gst:invoiceDate   "2020-07-12" ;
    gst:taxableValue  "80000.00" ;
    gst:taxAmount     "14400.00" ;
    gst:itcAvailable  "Y" ;
    gst:reverseCharge "N" ;
    gst:reflectedIn   gst:g2bstatement-2020-07 .

gst:invoice-27AABCU9603R1ZM-INV2002 rdf:type gst:Invoice ;
