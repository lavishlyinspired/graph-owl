# A matched invoice the authority reports as carrying no usable credit.
#
# Worth separating from a mismatch: the numbers agree, the supplier filed, and
# there is still nothing to claim — most often a blocked credit under Section
# 17(5). A reconciliation that only compared amounts would report this invoice
# as perfectly fine, and the taxpayer would claim credit they do not have.

# The GSTIN is reached by traversal, not read off a literal — Epic 105c.

PREFIX gst: <https://graph-owl.dev/packs/gst#>

SELECT ?purchase ?number ?gstin ?taxAmount ?itcAvailable
WHERE {
  GRAPH ?register {
    ?purchase a gst:PurchaseInvoice ;
              gst:issuedBy ?supplier ;
              gst:invoiceNumber ?number ;
              gst:invoiceKey    ?key ;
              gst:taxAmount     ?taxAmount .
    ?supplier gst:supplierGstin ?gstin .
  }
  GRAPH ?authority {
    ?filed a gst:Gstr2bInvoice ;
           gst:issuedBy ?filedSupplier ;
           gst:invoiceKey    ?key ;
           gst:itcAvailable  ?itcAvailable .
    ?filedSupplier gst:supplierGstin ?gstin .
  }
  FILTER (?itcAvailable != "Y")
}
ORDER BY ?number
