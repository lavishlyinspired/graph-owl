# Console configuration. Copy to `ui/.env` — gitignored — and fill in.
#
# `VITE_`-prefixed variables are inlined into the bundle at build time and are
# therefore **public**. Nothing secret belongs here, and nothing here is secret:
# a public SPA client id is designed to be readable, which is exactly why PKCE
# exists.
#
# They are still configuration rather than literals, because a tenant baked into
# source is a code change for every deployment that is not the one it was
# written for — and the fallbacks in `src/auth/index.tsx` are a *development*
# tenant, which is the value that must not silently ship.

VITE_OIDC_DOMAIN=dev-uzuxwkbcozynti2m.us.auth0.com
VITE_OIDC_CLIENT_ID=1YagciKTz39X5IlvZnYjFylGgzJRVkI6

# Must equal the server's OIDC_AUDIENCE. The console asks Auth0 for a token
# *for this audience*; the server validates `aud` against its own. A mismatch
# produces a token the console considers a success and the server rejects.
VITE_OIDC_AUDIENCE=https://graph-owl.dev/api

# ---- The callback URL is not configured here ---------------------------------
#
# It is computed as `${window.location.origin}/callback`, so it follows whatever
# origin the console is actually served from. That means **two** URLs must be
# registered in Auth0 → Applications → Settings:
#
#   http://localhost:8080/callback   the binary serving the embedded SPA
#   http://localhost:5173/callback   `npm run dev`, where Vite serves it
#
# Add both to Allowed Callback URLs, both origins to Allowed Web Origins, and
# both to Allowed Logout URLs. Registering only the 8080 form means the dev loop
# fails with "Callback URL mismatch" and the built bundle is the only thing ever
# tested.
