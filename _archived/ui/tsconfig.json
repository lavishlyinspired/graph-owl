{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src"
  ],
  // Generated from `openapi.json` and run only by
  // `scripts/verify-generated-client.sh`, which points it at a live server. It
  // imports Node globals and a file that is not committed, so it is not part of
  // the console's own typecheck.
  "exclude": ["src/generated"]
}
