# graph-owl server configuration.
#
# Copy to `.env` — which is gitignored — and fill in. Loaded at startup by
# `dotenvy`, which **never overrides a variable that is already set**, so an
# orchestrator's injected value always beats this file.

# ---- Storage -----------------------------------------------------------------

# The catalog's own database. Both the relational store and the graph engine
# connect to it; each runs its own migrations against its own tables.
#
# Redacted wherever it is logged — the password only, so the host and database
# that make a startup failure diagnosable survive.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/graphowl

# PostgreSQL 14 is the floor and 18 is what the suite is tested against.
# See plans/00g-operations.md, "Supported PostgreSQL versions".

BIND_ADDR=0.0.0.0:8080

# ---- Authentication ----------------------------------------------------------
#
# Three modes, and OIDC wins if both are configured. Neither set is *open mode*:
# every request runs as the system principal, which is a legitimate local
# posture and an alarming production one. Startup says which it is.

# The `iss` claim, matched **exactly** — trailing slash included. Auth0 issues
# `https://<tenant>.us.auth0.com/` with one, and omitting it rejects every token
# with "issuer does not match". Confirm against
# https://<tenant>.us.auth0.com/.well-known/openid-configuration
OIDC_ISSUER=https://dev-uzuxwkbcozynti2m.us.auth0.com/

# The API identifier from Auth0 → Applications → APIs. Validated as `aud`.
OIDC_AUDIENCE=https://graph-owl.dev/api

# HS256 shared secret. Legacy and a demo affordance; leave unset when using
# OIDC. Setting both logs a warning — the secret is then dead weight at best,
# and a live credential somebody believes is in use at worst.
# GRAPH_OWL_JWT_SECRET=

# ---- The first administrator -------------------------------------------------
#
# Without this, the *first* sign-in renders an empty catalog: identities are
# auto-provisioned with no roles and authorization denies by default, so a
# completely successful login looks like an empty estate. Granting the first
# role otherwise requires direct SQL.
#
# Comma-separated `sub` claims. For an Auth0 database connection a `sub` looks
# like `auth0|6xxxxxxxxxxxxxxxxxxxxxxx`; it is the `user_id` on the Auth0 user.
#
# Elevation is applied after resolution and never written to the database, so
# removing this variable and restarting revokes it.
GRAPH_OWL_ADMIN_SUBJECTS=

# ---- Roles from the token (opt-in, off by default) --------------------------
#
# Names a claim whose value is a JSON array of strings; those become roles on
# the principal, merged with whatever the catalog already grants.
#
# Unset means the token contributes no roles at all, which is the default and
# the safer one: an identity provider deciding what this catalog authorizes is
# a reasonable arrangement and a terrible default, because it is invisible to
# anyone reading the policies.
#
# Auth0 namespaces custom claims, so there is no portable name to assume:
#   OIDC_ROLES_CLAIM=https://graph-owl.dev/roles
OIDC_ROLES_CLAIM=

# ---- Memory budget ------------------------------------------------------------
#
# Absolute and itemized, never a percentage of RAM. `00a-product-position.md`
# states a footprint — "runs in 2 GB" — and "takes 35% of whatever you give it"
# cannot also be true. An operator sizing a container adds these numbers.
#
# Each is a whole number of **megabytes**. Unset uses the default from
# `10-operability.md`. Zero is legitimate and means "do not cache".
#
# Only the authorization line is allocated by this build; the rest budget for
# caches whose epics have not shipped, and startup reports both totals so the
# difference is visible rather than implied.
#
# GRAPH_OWL_BUDGET_SHAPES_MB=32          # Epic 5,  compiled SHACL shapes
# GRAPH_OWL_BUDGET_VECTOR_MB=512         # Epic 8,  vector index (resident, not a cache)
# GRAPH_OWL_BUDGET_QUERY_PLANS_MB=16     # Epic 7,  query plans
# GRAPH_OWL_BUDGET_AUTHZ_MB=32           # Epic 13, authorization decisions  <-- built
# GRAPH_OWL_BUDGET_ANALYTICS_MB=64       # Epic 38, analytics results
# GRAPH_OWL_BUDGET_REASONING_MB=512      # Epic 6,  reasoning working set
#
# The container's cgroup limit is read only to *check* this total and refuse to
# start if what is allocated will not fit. It never derives the budget — that
# would reintroduce the percentage model through the back door.

# ---- Admission control -------------------------------------------------------
#
# How many expensive requests may be in flight at once. Anything beyond the
# limit is **refused immediately** with `503` and `Retry-After`, never queued:
# an unbounded queue turns an overload into a latency collapse where every
# client waits, times out and retries, while a fast refusal lets a well-behaved
# client back off and leaves the in-flight requests completing at normal speed.
#
# Each class is limited separately, so an ingestion storm cannot shed reads.
#
# The default of 10 is the Postgres pool size, not a tuning number: every
# controlled path holds a connection for its whole duration, so permits above
# the pool do not admit more work — they move the queue out of the semaphore,
# where it is bounded and measured, and into the pool, where it is neither.
#
# Zero is refused at startup. It would reject every request on the path forever,
# which at the client is indistinguishable from the service being broken, and it
# is far more often a typo than an intent.
#
# GRAPH_OWL_ADMISSION_QUERY_PERMITS=10        # /sparql, /assets/{id}/graph
# GRAPH_OWL_ADMISSION_INGESTION_PERMITS=10    # connector runs, /graph/reconcile
# GRAPH_OWL_ADMISSION_RETRY_AFTER_SECONDS=1   # smallest value Retry-After can express

# ---- Observability -----------------------------------------------------------

# `LOG_FORMAT=json` for a log collector; anything else renders for a person.
# Not the default: during development the reader is a human, and a default
# unreadable to them is one that gets turned off and never turned back on.
LOG_FORMAT=text

# Standard `tracing` filter syntax, e.g. `info`, `debug`,
# `info,graph_owl_server=debug`.
LOG_LEVEL=info

# ---- GSTR-2B ingestion (Epic 105 P2) -----------------------------------------
#
# GSTN does not sell API access directly — it is reached through an empanelled
# GSP, and every GSP wraps the same returns behind its own auth and envelope.
# So no vendor is named anywhere in the code: `graph-owl-gstr2b` takes a base
# URL and a key, and changing provider is changing these two lines.
#
# **Unset is the normal state.** With neither set, the connector reads a saved
# response (`--from-file`) and the entire reconciliation — matching, mismatch
# detection, ITC availability, reverse charge, the 180-day span — runs at zero
# API cost. Live access changes where the bytes come from and nothing else.
# GSP_API_BASE_URL=https://<your-gsp>/gst/api/v1
# GSP_API_KEY=

# ---- Language model (optional) ------------------------------------------------
#
# Same shape as EMBEDDING_API_BASE_URL above: any OpenAI-compatible endpoint,
# so the deployment picks the provider rather than the code hardcoding one.
#
# **Nothing in the reconciliation depends on this.** Findings are produced by
# rules over the graph and cite a statute; a model only narrates one that has
# already been derived. That ordering is deliberate — a model handed wrong
# findings narrates them fluently and a reviewer believes it.
# LLM_API_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
