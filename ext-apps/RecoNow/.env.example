# Reco Now — local configuration template. Copy to `.env` and edit.
# `.env` is gitignored; this file is the tracked template and must never
# carry a real value.
#
# Everything here has a working local default in `run-dev.sh`, so an empty
# `.env` runs against the shared test container. Set these only when the
# database is not that container.

# Postgres. The defaults below are the local testcontainer's own credentials,
# which are public by construction — not a secret being leaked.
PGHOST=127.0.0.1
PGPORT=55000
PGUSER=postgres
PGPASSWORD=postgres

# Or bypass the parts above entirely and give each service its whole DSN.
# GRAPHOWL_DATABASE_URL=postgresql://user:pass@host:5432/graphowl_reconow
# RECONOW_DATABASE_URL=postgresql://user:pass@host:5432/reconow

# Where Reco Now reaches graph-owl. Must not be Reco Now's own port (:8000) —
# a self-reference loads no pack and produces no finding, while the UI still
# renders, which is what makes it dangerous. run-dev.sh checks for this.
GRAPH_OWL_SERVER=http://127.0.0.1:8080

# Left blank locally to select graph-owl's AuthMode::Open. Setting an issuer
# without giving Reco Now a token to present 401s every call it makes.
OIDC_ISSUER=
GRAPH_OWL_JWT_SECRET=
