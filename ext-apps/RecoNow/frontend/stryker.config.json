{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.ts",
    "!src/lib/**/*.test.ts",
    "!src/lib/api.ts",
    "!src/lib/screenConfigs.ts",
    "!src/lib/routes.ts"
  ],
  "thresholds": { "high": 90, "low": 70, "break": 55 },
  "timeoutMS": 20000
}
